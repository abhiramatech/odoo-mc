<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- tree view -->
    <record model="ir.ui.view" id="view_transfer_type_tree">
      <field name="name">transfer.type.tree</field>
      <field name="model">transfer.type</field>
      <field name="arch" type="xml">
        <tree string="Transfer Type" editable="bottom">
          <field name="name" string="Jenis Transaksi"/>
          <field name="active" optional="hide" widget="boolean_toggle"/>
        </tree>
      </field>
    </record>

    <!-- form view -->
    <record model="ir.ui.view" id="view_transfer_type_form">
      <field name="name">transfer.type.form</field>
      <field name="model">transfer.type</field>
      <field name="arch" type="xml">
        <form string="Transfer Type">
          <sheet>
            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                    invisible="active"/>
            <group>
              <group string="Transfer Type">
                <field name="name" placeholder="Contoh: Alokasi Stock"/>
                <field name="active"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- search view -->
    <record model="ir.ui.view" id="view_transfer_type_search">
      <field name="name">transfer.type.search</field>
      <field name="model">transfer.type</field>
      <field name="arch" type="xml">
        <search string="Transfer Type">
          <field name="name" string="Jenis Transaksi"
                 filter_domain="[('name', 'ilike', self)]"/>
          <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
        </search>
      </field>
    </record>

    <!-- action -->
    <record model="ir.actions.act_window" id="action_transfer_type">
      <field name="name">Transfer Type</field>
      <field name="res_model">transfer.type</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_transfer_type_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Buat jenis transaksi pertama untuk Transfer Out.
        </p>
      </field>
    </record>

    <!-- menu: digabung dengan master data VIT lainnya -->
    <menuitem
      id="menu_transfer_type"
      name="Transfer Type"
      action="action_transfer_type"
      parent="dev_pos.setting_config_menu_root"
      sequence="16"/>

  </data>
</odoo>
