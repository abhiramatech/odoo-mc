<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <menuitem
      id="menu_transfer_root"
      name="Transfer"
      parent="stock.menu_stock_root"
      sequence="15"/>

    <record id="action_picking_ts_in" model="ir.actions.act_window">
      <field name="name">TS In</field>
      <field name="res_model">stock.picking</field>
      <field name="view_mode">tree,kanban,form,calendar</field>
      <field name="domain">[('picking_type_id.name', '=', 'TS In')]</field>
      <field name="context">{'contact_display': 'partner_address', 'default_company_id': allowed_company_ids[0]}</field>
      <field name="search_view_id" ref="stock.view_picking_internal_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Belum ada transfer dengan operation type TS In.
        </p>
      </field>
    </record>

    <record id="action_picking_ts_out" model="ir.actions.act_window">
      <field name="name">TS Out</field>
      <field name="res_model">stock.picking</field>
      <field name="view_mode">tree,kanban,form,calendar</field>
      <field name="domain">[('picking_type_id.name', '=', 'TS Out')]</field>
      <field name="context">{'contact_display': 'partner_address', 'default_company_id': allowed_company_ids[0]}</field>
      <field name="search_view_id" ref="stock.view_picking_internal_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Belum ada transfer dengan operation type TS Out.
        </p>
      </field>
    </record>

    <menuitem
      id="menu_transfer_ts_in"
      name="TS In"
      action="action_picking_ts_in"
      parent="menu_transfer_root"
      sequence="2"/>

    <menuitem
      id="menu_transfer_ts_out"
      name="TS Out"
      action="action_picking_ts_out"
      parent="menu_transfer_root"
      sequence="3"/>
  </data>
</odoo>
