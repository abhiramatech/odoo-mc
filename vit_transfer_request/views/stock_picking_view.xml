<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Transfer Request asal + input Transfer Type pada form Transfer Out -->
    <record model="ir.ui.view" id="view_stock_picking_form_transfer_request">
      <field name="name">stock.picking.form.transfer.request</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='origin']" position="after">
            <field name="vit_transfer_request_id"/>
            <field name="vit_transfer_type_id"
                   options="{'no_quick_create': True}"
                   readonly="state in ['assigned', 'done']"/>
        </xpath>
        <xpath expr="//field[@name='vit_transfer_request_id']" position="attributes">
          <attribute name="force_save">1</attribute>
          <attribute name="readonly">True</attribute>
          <attribute name="invisible">not vit_transfer_request_id</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
