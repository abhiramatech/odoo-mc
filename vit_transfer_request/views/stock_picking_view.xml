<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Transfer Request asal + input Transfer Type pada form Transfer Out -->
    <record model="ir.ui.view" id="view_stock_picking_form_transfer_request">
      <field name="name">stock.picking.form.transfer.request</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <!-- TS Out -> TS In: TS In dibuat otomatis saat TS Out Done. Smart button hanya untuk group TS In Creator -->
        <xpath expr="//div[@name='button_box']" position="inside">
            <field name="vit_is_ts_out" invisible="1"/>
            <button name="action_view_ts_in" type="object" class="oe_stat_button" icon="fa-truck"
                    groups="vit_transfer_request.group_ts_in_creator"
                    invisible="not vit_is_ts_out or ts_in_count == 0">
                <field name="ts_in_count" widget="statinfo" string="TS In"/>
            </button>
        </xpath>
        <xpath expr="//field[@name='origin']" position="after">
            <field name="vit_is_ts_in" invisible="1"/>
            <field name="transfer_out_id"
                   options="{'no_create': True, 'no_quick_create': True}"
                   invisible="not vit_is_ts_in"
                   required="vit_is_ts_in"
                   readonly="state in ['done', 'cancel']"/>
            <field name="vit_transfer_request_id"/>
            <field name="vit_transfer_type_id"
                   options="{'no_quick_create': True}"
                   readonly="state in ['assigned', 'done']"/>
            <!-- Gudang tujuan akhir: wajib di TS Out, dipakai buat nentuin tujuan TS In -->
            <field name="vit_warehouse_dest_id"
                   options="{'no_create': True, 'no_quick_create': True}"
                   invisible="not vit_is_ts_out and not vit_is_ts_in"
                   required="vit_is_ts_out"
                   readonly="state in ['done', 'cancel'] or vit_is_ts_in"/>
        </xpath>
        <!-- Dokumen TS In: Source Document bawaan disembunyikan, diganti TS Out Reference -->
        <xpath expr="//field[@name='origin']" position="attributes">
          <attribute name="invisible">vit_is_ts_in</attribute>
        </xpath>
        <xpath expr="//field[@name='vit_transfer_request_id']" position="attributes">
          <attribute name="force_save">1</attribute>
          <attribute name="readonly">True</attribute>
          <attribute name="invisible">not vit_transfer_request_id</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
